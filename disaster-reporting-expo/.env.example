EXPO_PUBLIC_USE_REAL_API=true
# Local development: this URL is auto-updated by start-all.bat/start-all-lan.bat with your current local IP.
EXPO_PUBLIC_API_BASE_URL=http://YOUR_LOCAL_IP:8000/api

# Production/no-local-Laravel option:
# Deploy the Laravel backend online, then use its public API URL here instead.
# EXPO_PUBLIC_API_BASE_URL=https://YOUR_DEPLOYED_LARAVEL_APP_URL/api
